############################################################
# OAManager v1 environment template
# Copy to .env only on the deployment host. Never commit .env.
############################################################

# Domains
OA_DOMAIN=oa.example.com
OA_SUPABASE_PUBLIC_URL=https://api-oa.example.com
OA_SITE_URL=https://oa.example.com
OA_ADDITIONAL_REDIRECT_URLS=https://oa.example.com

# PostgreSQL and Supabase JWTs
# Use unique URL-safe hex values. Each value belongs to one database login
# role and must never be reused for another role.
OA_POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_POSTGRES_ROLE_PASSWORD
OA_SUPABASE_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SUPABASE_ADMIN_PASSWORD
OA_SUPABASE_AUTH_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_SUPABASE_AUTH_ADMIN_PASSWORD
OA_AUTHENTICATOR_PASSWORD=REPLACE_WITH_A_RANDOM_AUTHENTICATOR_PASSWORD
OA_SUPABASE_STORAGE_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_STORAGE_ADMIN_PASSWORD
OA_JWT_SECRET=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET
OA_JWT_EXPIRY=3600
OA_ANON_KEY=REPLACE_WITH_A_JWT_SIGNED_BY_OA_JWT_SECRET
OA_SERVICE_ROLE_KEY=REPLACE_WITH_A_JWT_SIGNED_BY_OA_JWT_SECRET

# Dashboard and service secrets
OA_DASHBOARD_USERNAME=REPLACE_WITH_A_PRIVATE_DASHBOARD_USERNAME
OA_DASHBOARD_PASSWORD=REPLACE_WITH_A_RANDOM_DASHBOARD_PASSWORD
OA_SECRET_KEY_BASE=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET
OA_PG_META_CRYPTO_KEY=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET

# Email
OA_ENABLE_EMAIL_SIGNUP=false
OA_ENABLE_EMAIL_AUTOCONFIRM=false
OA_DISABLE_SIGNUP=true
OA_SMTP_ADMIN_EMAIL=admin@example.com
OA_SMTP_HOST=smtp.example.com
OA_SMTP_PORT=587
OA_SMTP_USER=REPLACE_WITH_SMTP_USERNAME
OA_SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
OA_SMTP_SENDER_NAME=OAManager

# Edge functions and PostgREST
OA_FUNCTIONS_VERIFY_JWT=true
OA_PGRST_DB_SCHEMAS=public,storage,graphql_public
